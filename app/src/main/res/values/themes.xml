<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La UI è tutta in Compose: il tema XML serve solo alla finestra e allo splash. -->
    <style name="Theme.OpenCGD1" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.OpenCGD1.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenCGD1</item>
    </style>
</resources>
