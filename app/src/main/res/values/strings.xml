    <string name="welcome_intro_title">Welcome to OpenCGD1</string>
    <string name="welcome_intro_body">Control your Qingping CGD1 alarm clock directly over Bluetooth: alarms, time, ringtone and settings. No account, no cloud, no Mi Home.</string>
    <string name="welcome_prepare_title">Prepare the clock</string>
    <string name="welcome_prepare_body">The clock accepts only one app at a time. If you have used it with Mi Home or Qingping+, it has to be released first.</string>
    <string name="welcome_prepare_step_1">Remove the clock from Mi Home or Qingping+.</string>
    <string name="welcome_prepare_step_2">Or hold the clock\'s button until the Bluetooth icon blinks.</string>
    <string name="welcome_prepare_step_3">On the first connection the clock binds to OpenCGD1, and Mi Home will no longer see it.</string>
    <string name="welcome_permission_title">Bluetooth permission</string>
    <string name="welcome_permission_body">It is used only to find the clock and talk to it. The app does not use your location.</string>
    <string name="welcome_permission_granted">Permission granted</string>
    <string name="welcome_ready_title">All set</string>
    <string name="welcome_ready_body">Keep the phone close to the clock: the app will look for it by itself. You can see this guide again from Settings.</string>
