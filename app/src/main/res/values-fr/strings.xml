    <string name="welcome_intro_title">Bienvenue dans OpenCGD1</string>
    <string name="welcome_intro_body">Pilotez votre réveil Qingping CGD1 directement en Bluetooth : alarmes, heure, sonnerie et réglages. Sans compte, sans cloud, sans Mi Home.</string>
    <string name="welcome_prepare_title">Préparez le réveil</string>
    <string name="welcome_prepare_body">Le réveil n\'accepte qu\'une appli à la fois. Si vous l\'avez utilisé avec Mi Home ou Qingping+, il faut d\'abord le libérer.</string>
    <string name="welcome_prepare_step_1">Supprimez le réveil de Mi Home ou Qingping+.</string>
    <string name="welcome_prepare_step_2">Ou maintenez le bouton du réveil jusqu\'à ce que l\'icône Bluetooth clignote.</string>
    <string name="welcome_prepare_step_3">À la première connexion, le réveil se lie à OpenCGD1 et Mi Home ne le verra plus.</string>
    <string name="welcome_permission_title">Autorisation Bluetooth</string>
    <string name="welcome_permission_body">Elle sert uniquement à trouver le réveil et à communiquer avec lui. L\'appli n\'utilise pas votre position.</string>
    <string name="welcome_permission_granted">Autorisation accordée</string>
    <string name="welcome_ready_title">Tout est prêt</string>
